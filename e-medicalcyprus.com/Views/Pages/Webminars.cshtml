@{
    ViewData["Title"] = "About Us";
}

<!-- Appointment Start -->
<div class="container-fluid py-5">
    <div class="container">
        <div class="row gx-5">
            <div class="col-lg-5 mb-5 mb-lg-0" style="min-height: 500px;">
                <div class="position-relative h-100">
                    <img class="position-absolute w-100 h-100 rounded"
                         src="~/img/webminars.jpg" alt="Webmnars"
                         style="object-fit: cover;">
                </div>
            </div>
            <div class="col-lg-7">
                <div class="row gx-5">
                    <div class="col-lg-12 mb-5 mb-lg-0">
                        <div class="mb-4">
                            <h5 class="d-inline-block text-primary text-uppercase border-bottom border-5">Webminars</h5>
                        </div>
                        <p class="mb-5">Explore future insights! Join our upcoming webinars for expert-led sessions. Subscribe to stay in the know and secure your spot. Don't miss the chance to learn, grow, and stay ahead.</p>
                    </div>
                    <div class="col-lg-12">
                        <div class="bg-light text-center rounded p-5">
                            <h1 class="mb-4">Subscribe to Our Mailing List</h1>
                            <form method="post">
                                @if (ViewData["Confirm"] != null)
                                {
                                    <div class="alert alert-success" role="alert">
                                        @ViewData["Confirm"]
                                    </div>
                                }
                                <div class="row g-3">
                                    <div class="col-12">
                                        <input type="text" class="form-control bg-white border-0" placeholder="Your Name" style="height: 55px;" id="Name" name="Name" />
                                    </div>
                                    <div class="col-12">
                                        <input type="email" class="form-control bg-white border-0" placeholder="Your Email" style="height: 55px;" id="Email" name="Email" />
                                    </div>
                                    <div class="col-12">
                                        <button class="btn btn-primary w-100 py-3" type="submit">Subscribe</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<!-- Appointment End -->
