@{
    ViewData["Title"] = "Why Us";
}
<div class="container-fluid py-5">
    <div class="container">
        <div class="row gx-5">
            <div class="col-lg-5 mb-5 mb-lg-0" style="min-height: 500px;">
                <div class="position-relative h-100">
                    <img class="position-absolute w-100 h-100 rounded" 
                    src="~/img/why-us.jpg" alt="Why Us"
                         style="object-fit: cover;">
                </div>
            </div>
            <div class="col-lg-7">
                <div class="mb-4">
                    <h5 class="d-inline-block text-primary text-uppercase border-bottom border-5">Why Choose E-Medical Instruments?</h5>
                </div>
               
                <p>
                    <h6>Quality Assurance: </h6>
                    We assure top-quality, well-maintained equipment to assist the success of
                    your practise.
                </p>
                <p>
                    <h6>Expert Advice: </h6>
                    Our team of skilled professionals provides comprehensive guidance and
                    instruction regarding how to operate your equipment properly.
                </p>
                <p>
                    <h6>Flexibility: </h6>
                    Customised rental arrangements adapted to the needs of your practise.
                </p>
                <p>
                    <h6>Customer satisfaction: </h6>
                    Our top objective is to assure your success.
                </p>
                <p>
                    <h6>Get in Touch: </h6>
                    Ready to take your dental practice to the next level? Contact us today to discuss
                    your equipment rental needs and schedule personalized training sessions.

                </p>
            </div>
        </div>
    </div>
</div>
