@{
    ViewData["Title"] = "Services";
}
<div class="container-fluid py-5">
    <div class="container">
        <div class="row gx-5">
            <div class="col-lg-5 mb-5 mb-lg-0" style="min-height: 500px;">
                <div class="position-relative h-100">
                    <img class="position-absolute w-100 h-100 rounded" 
                    src="~/img/services.jpg" alt="Services"
                         style="object-fit: cover;">
                </div>
            </div>
            <div class="col-lg-7">
                <div class="mb-4">
                    <h5 class="d-inline-block text-primary text-uppercase border-bottom border-5">Our Services?</h5>
                </div>

                <p>
                    <h6>Dental Equipment Rental & Training: </h6>
                    E-Medical Instruments thrives in the rental of dental devices as well as thorough training services.
                    Our objective is to provide dental professionals with advanced instruments and the knowledge t
                    hey need to improve their practise.
                    <br />
                    Explore our wide range of innovative dental devices available for short or
                    long-term rental. We have the resources you need to improve patient care, from digital imaging
                    systems to modern treatment units.
                </p>
                <p>
                    <h6>Training: </h6>
                    Our expert-led training programmes are designed to provide dental teams with the
                    knowledge and skills they need to optimise equipment usage, maximise efficiency, and assure
                    patient satisfaction. We provide hands-on sessions and online tools that are suited to the needs
                    of your practise.

                </p>
                <p>
                    <h6>Consultation & Support: </h6>
                    In addition to renting equipment and offering training, we provide
                    continuous consultation and support to ensure that the rented tools are seamlessly integrated
                    and utilised in your practise.
                </p>
            </div>
        </div>
    </div>
</div>
